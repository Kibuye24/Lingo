# Only needed for conversation mode (/gesprek).
# Lessons, the sound lab and review all work without it.
# Get a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Cross-device sync (optional). Create a free project at supabase.com,
# run supabase/migrations/0001_init.sql in its SQL editor, then paste
# Project Settings -> API -> Project URL and anon/public key here.
# The anon key is safe in the browser: Row Level Security scopes every
# table to the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
